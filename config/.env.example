########################################################################
#                         config/.env.example                          #
########################################################################
# Author:            Kevin Street
# Created on:        2026-10-14
# Last modified on:  2026-10-29
#
# The names of every secret, with empty values. Copy this file to
# config/.env and fill in what you need; never commit config/.env.
# Secrets only: every other setting lives in config/config.toml.

# The approver's token, at least 32 characters. Unset, the approver routes are off.
# Make one with: python -c 'import secrets; print(secrets.token_urlsafe(32))'
APPROVER_TOKEN=

# Only the key for the provider set in [llm] provider is needed.
# The default provider, fake, is the offline stand-in and needs none.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
AZURE_OPENAI_API_KEY=
